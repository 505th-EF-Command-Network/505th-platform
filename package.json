{
  "name": "505th-platform",
  "version": "0.1.0",
  "private": true,
  "description": "505th Expeditionary Force Command Network — website, 505th Hub and Cortana v2.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/migrate-firebase"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:all": "node scripts/dev-all.mjs",
    "hub": "npm run dev -w @505th/hub",
    "hub:build": "npm run build -w @505th/hub",
    "hub:typecheck": "npm run typecheck -w @505th/hub",
    "hub:dist": "npm run dist -w @505th/hub"
  }
}
