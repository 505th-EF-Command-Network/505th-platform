# Cortana v2 settings. Copy this file to .env.local and fill in the blanks.
# .env.local is never committed. Never paste these values in chat.

# Bot token — Developer Portal → your bot → Bot → Reset Token (the test bot: copy from Cortana_Bot_Test\.env)
DISCORD_TOKEN=
# Application ID (not secret) — test bot
DISCORD_CLIENT_ID=1384070313251180585
# The only server Cortana works in (not secret) — test server
AUTHORISED_GUILD_ID=1383875115024126152
# Optional: Discord role that may use Cortana commands even without website access ("Cortana Cred")
CORTANA_CRED_ROLE_ID=1383875115024126154

# Events: where sign-ups for events made directly in Discord are posted, and the mission log (not secret)
EVENT_CHANNEL_ID=1383875117356023876
MISSION_LOG_CHANNEL_ID=1384263753511604365
# Role pinged for "Signup Open", 30-min warning and "has started" (old config: roleIds.events)
EVENTS_ROLE_ID=1383875115024126155
# Optional: "Open on website" button on sign-up posts
SITE_URL=

# Same database as the website (copy from apps/website/.env.local)
MONGODB_URI=
MONGODB_DB=505th

# Ably instant updates (optional — polling works without it)
ABLY_API_KEY=x5Rx5A.X-V26w:7lcvCdpeVcZBMh7q0f20FvApZSMB16N20trg_00GOR0
