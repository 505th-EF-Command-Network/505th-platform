# Copy to apps/website/.env.local (and apps/cortana/.env) and fill in. NEVER commit real values.

# MongoDB Atlas connection string and database name
MONGODB_URI=
MONGODB_DB=505th

# Public URL of the website (no trailing slash). Dev: http://localhost:3000
APP_URL=http://localhost:3000

# Discord application (Developer Portal → your app → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The 505th Discord server id (right-click server → Copy Server ID, with Developer Mode on)
DISCORD_GUILD_ID=

# Cortana bot token (Developer Portal → Bot → Reset Token). Used by apps/cortana only.
DISCORD_BOT_TOKEN=

# Cloudinary (Gallery + AAR images). Dashboard → Settings → API Keys.
# The secret stays on the server; browsers only get a short-lived signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
